{
  "rules": {
    ".read": false,
    ".write": false,

    "telecare": {

      "live": {
        ".read": true,
        ".write": false
      },

      "demo": {

        "consults": {
          "$consultId": {
            ".read": "auth != null && data.child('meta/members').hasChild(auth.uid)",

            "meta": {
              "members": {
                "$uid": {
                  ".write": "auth != null && $uid == auth.uid",
                  ".validate": "newData.isBoolean()"
                }
              },

              "doctorId": {
                ".write": "auth != null && root.child('telecare/demo/consults/' + $consultId + '/meta/members').hasChild(auth.uid)",
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "mode": {
                ".write": "auth != null && root.child('telecare/demo/consults/' + $consultId + '/meta/members').hasChild(auth.uid)",
                ".validate": "newData.val() == 'chat' || newData.val() == 'video' || newData.val() == 'audio'"
              },
              "status": {
                ".write": "auth != null && root.child('telecare/demo/consults/' + $consultId + '/meta/members').hasChild(auth.uid)",
                ".validate": "newData.val() == 'active' || newData.val() == 'done'"
              },
              "startedAt": {
                ".write": "auth != null && root.child('telecare/demo/consults/' + $consultId + '/meta/members').hasChild(auth.uid)",
                ".validate": "newData.isNumber()"
              },
              "doctorOnline": {
                ".write": "auth != null && root.child('telecare/demo/consults/' + $consultId + '/meta/members').hasChild(auth.uid)",
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            },

            "messages": {
              "$messageId": {
                ".write": "auth != null && root.child('telecare/demo/consults/' + $consultId + '/meta/members').hasChild(auth.uid) && !data.exists()",
                ".validate": "newData.hasChildren(['at', 'uid', 'from'])",

                "uid": {
                  ".validate": "newData.val() == auth.uid"
                },
                "from": {
                  ".validate": "newData.val() == 'me' || newData.val() == 'doc' || newData.val() == 'sys'"
                },
                "at": {
                  ".validate": "newData.isNumber()"
                },
                "text": {
                  ".validate": "newData.isString() && newData.val().length <= 2000"
                },
                "mid": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "$other": {
                  ".validate": false
                }
              }
            },

            "$other": {
              ".validate": false
            }
          }
        },

        "duty": {
          "$doctorId": {
            ".read": "auth != null",
            ".write": "auth != null && (!newData.exists() || newData.child('uid').val() == auth.uid)",

            "uid": {
              ".validate": "newData.val() == auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "inbox": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",

            "$ringId": {
              ".read": "auth != null && (auth.uid == $uid || data.child('from').val() == auth.uid)",
              ".write": "auth != null && (!data.exists() ? newData.child('from').val() == auth.uid : (auth.uid == $uid || data.child('from').val() == auth.uid))",
              ".validate": "!newData.exists() || newData.hasChildren(['from', 'at'])",

              "from": {
                ".validate": "newData.val() == auth.uid"
              },
              "fromName": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "consultId": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              },
              "mode": {
                ".validate": "newData.val() == 'chat' || newData.val() == 'audio' || newData.val() == 'video'"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "status": {
                ".validate": "newData.val() == 'ringing' || newData.val() == 'accepted' || newData.val() == 'declined' || newData.val() == 'canceled' || newData.val() == 'missed'"
              },
              "answeredAt": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },

        "push": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid",

            "token": {
              ".validate": "newData.isString() && newData.val().length <= 4096"
            },
            "role": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "rooms": {
          "$roomId": {
            ".read": "auth != null && root.child('telecare/demo/consults/' + $roomId + '/meta/members').hasChild(auth.uid)",
            ".write": "auth != null && root.child('telecare/demo/consults/' + $roomId + '/meta/members').hasChild(auth.uid)",

            "offer": {
              "sdp": {
                ".validate": "newData.isString() && newData.val().length <= 30000"
              },
              "type": {
                ".validate": "newData.val() == 'offer'"
              },
              "$other": {
                ".validate": false
              }
            },
            "answer": {
              "sdp": {
                ".validate": "newData.isString() && newData.val().length <= 30000"
              },
              "type": {
                ".validate": "newData.val() == 'answer'"
              },
              "$other": {
                ".validate": false
              }
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "callerCandidates": {
              "$c": {
                ".validate": "newData.hasChild('candidate') || newData.hasChild('sdpMid')"
              }
            },
            "calleeCandidates": {
              "$c": {
                ".validate": "newData.hasChild('candidate') || newData.hasChild('sdpMid')"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
